# ========================================================
# QUICKBITES FOOD DELIVERY - PRODUCTION BACKEND CONFIG
# ========================================================

# Server Port
PORT=4000

# MongoDB Atlas / Cloud Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quickbites?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/food-del

# JWT Authentication Secret Key (Generate strong 64-char key)
JWT_SECRET=super_secret_jwt_key_quickbites_production_2026

# Allowed Frontend & Admin URLs for CORS & WebSockets
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Razorpay Production / Test Credentials
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Stripe Credentials (Optional if using Razorpay & UPI)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Cloudinary Storage for Dish Images (Optional, local /images used by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
