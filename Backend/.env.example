PORT=4000
NODE_ENV=production

# MongoDB Connection String
MONGO_URI=your_mongodb_connection_string_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway
STRIPE_SECRET_KEY=your_stripe_secret_key
